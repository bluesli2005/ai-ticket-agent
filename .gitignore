# Python 虚拟环境与编译缓存
.venv/
venv/
__pycache__/
*.py[cod]

# 本地业务数据、备份与运行状态
/data/
/.backups/
/.runtime/
*.log
*.pid

# 本地环境配置（保留可提交的配置模板）
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 测试、覆盖率与静态检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
/coverage.xml

# macOS 与编辑器临时文件
.DS_Store
._*
*.swp
*.swo
*~
